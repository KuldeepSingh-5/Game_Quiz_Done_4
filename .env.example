# ---- Frontend environment variables ----

# Supabase project URL (found in your Supabase dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon (public) key — safe for the browser (found in Settings > API)
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Optional: backend API URL (if using the Express/MongoDB backend) ----
# Leave empty to use Supabase directly (default behavior)
# VITE_API_URL=http://localhost:5000

# ---- Optional: ad system ----
# Set to "true" to enable the ad placeholder system (banners, interstitials, rewarded)
# VITE_ADS_ENABLED=false
# Show an interstitial every N completed games
# VITE_INTERSTITIAL_FREQUENCY=3
# Enable rewarded ads (second-chance bonus XP)
# VITE_REWARDED_ADS_ENABLED=true
# Ad unit IDs (leave empty in dev — never hard-code real IDs)
# VITE_AD_UNIT_BANNER=
# VITE_AD_UNIT_INTERSTITIAL=
# VITE_AD_UNIT_REWARDED=
