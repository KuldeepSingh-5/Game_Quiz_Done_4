# ---- Server configuration ----

# Port the Express API listens on
PORT=5000

# Set to "production" for production deployments
NODE_ENV=production

# MongoDB connection string.
# For local dev: mongodb://127.0.0.1:27017/daily_challenge
# For MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/daily_challenge?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/daily_challenge

# Secret used to sign JWT auth tokens — use a long random string in production (min 32 chars)
JWT_SECRET=change_me_to_a_long_random_secret

# Comma-separated list of allowed CORS origins (the frontend URL(s))
# Example: https://your-app.vercel.app,https://your-custom-domain.com
CLIENT_URL=http://localhost:5173

# Admin token for admin API endpoints — use a long random string in production
ADMIN_TOKEN=change_me_admin_secret
